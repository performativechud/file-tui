# Maintainer: performativechud <performativechud@users.noreply.github.com>
pkgname=file-tui
pkgver=0.1.0
pkgrel=1
pkgdesc="Convert a dropped or pasted file to another format from the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/performativechud/file-tui"
license=('MIT')
depends=('glibc')
makedepends=('go')
optdepends=(
  'imagemagick: image conversion'
  'ffmpeg: audio/video conversion'
  'pandoc: document conversion'
  'libreoffice: office document conversion'
  'calibre: ebook conversion'
  'tesseract: OCR'
  'p7zip: 7z archive conversion'
  'poppler: PDF metadata'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  export CGO_ENABLED=0
  go build -trimpath -ldflags="-s -w" -o "$pkgname" .
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
